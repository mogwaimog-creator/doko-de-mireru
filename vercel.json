{
  "rewrites": [
    {
      "source": "/movie/:id",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/update-streaming",
      "schedule": "0 9,21 * * *"
    }
  ],
  "functions": {
    "api/seo-html-pilot.js": {
      "includeFiles": "{detail.html,person.html}"
    }
  },
  "git": {
    "deploymentEnabled": {
      "seo/initial-html-metadata-pilot": false
    }
  }
}
