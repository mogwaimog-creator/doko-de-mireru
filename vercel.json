{
  "crons": [
    {
      "path": "/api/update-streaming",
      "schedule": "0 21 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "work/four-ledgers-20261107": false
    }
  },
  "functions": {
    "api/detail-page.js": {
      "includeFiles": "detail.html"
    },
    "api/update-streaming.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/seo-route-probe",
      "destination": "/api/detail-page?id=1726"
    },
    {
      "source": "/detail.html",
      "destination": "/api/detail-page"
    },
    {
      "source": "/movie/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/detail.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
